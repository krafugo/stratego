{
  "name": "stratego",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5191 --strictPort",
    "test": "node --test tests/*.test.ts",
    "arena": "node scripts/arena.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "peer-room": "github:krafugo/peer-room#v1.0.1",
    "peerjs": "1.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
